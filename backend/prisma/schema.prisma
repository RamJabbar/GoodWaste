datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String        @id @default(uuid())
  email       String        @unique
  password    String
  name        String
  ecoPoints   Int           @default(0) @map("eco_points")
  co2SavedKg  Float         @default(0.0) @map("co2_saved_kg")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  actions     ActionLog[]
  vouchers    UserVoucher[]

  @@map("users")
}

model ActionLog {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType    String    @map("action_type") // CRAFT | DISPOSAL
  actionTitle   String    @map("action_title") // "Selesai Bikin Kerajinan" | "Sudah Dibuang ke Titik Sampah"
  itemName      String    @map("item_name")
  wasteCategory String    @map("waste_category")
  co2Amount     Float     @map("co2_amount")
  pointsEarned  Int       @map("points_earned")
  imageUrl      String?   @map("image_url")
  craftTitle    String?   @map("craft_title")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("action_logs")
}

model Reward {
  id          String        @id @default(uuid())
  title       String
  pointsCost  Int           @map("points_cost")
  description String
  category    String
  icon        String
  stock       Int           @default(999)
  createdAt   DateTime      @default(now()) @map("created_at")

  vouchers    UserVoucher[]

  @@map("rewards")
}

model UserVoucher {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId    String    @map("reward_id")
  reward      Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  voucherCode String    @unique @map("voucher_code")
  pointsSpent Int       @map("points_spent")
  status      String    @default("ACTIVE")
  redeemedAt  DateTime  @default(now()) @map("redeemed_at")

  @@map("user_vouchers")
}

model DropPoint {
  id               String   @id @default(uuid())
  name             String
  address          String
  latitude         Float
  longitude        Float
  phone            String?
  operationalHours String   @map("operational_hours")
  acceptedWaste    String   @map("accepted_waste")
  type             String   @default("BANK_SAMPAH") // BANK_SAMPAH | TPS_3R
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("drop_points")
}
